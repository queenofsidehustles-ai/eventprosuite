{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/join", "destination": "/join.html" },
    { "source": "/store/:slug", "destination": "/shopfront.html?slug=:slug" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/send-reminders?secret=pbh-cron",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
